{
  "name": "oneagentgraph-contract",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests",
  "tags": ["scope:tests", "lang:rust"],
  "implicitDependencies": ["oneagentgraph"],
  "targets": {
    "bootstrap": { "executor": "nx:noop" },
    "format": { "command": "just _tier-format contract" },
    "format-check": { "command": "just _tier-fmt-check contract", "inputs": ["contractSource", "{workspaceRoot}/rustfmt.toml"] },
    "lint": {
      "command": "just _tier-lint contract",
      "inputs": ["contractSource", "crateSource", "{workspaceRoot}/clippy.toml"]
    },
    "test": {
      "command": "just _tier-test contract",
      "inputs": ["contractSource", "crateSource", "contractReads"],
      "outputs": ["{workspaceRoot}/target/llvm-cov-target/oneagentgraph-contract-*.profraw"],
      "parallelism": false
    },
    "test-quick": { "command": "just _tier-test-quick contract", "parallelism": false },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "format-check",
        "lint",
        "test",
        // llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] this edge
        // is the 95% floor, not a dependency on unrelated code. A change confined to
        // this tier can lower the merged coverage (a deleted or narrowed test), so
        // the floor is re-measured, and measuring a union needs every counted
        // tier's profiles: e2e's replay from the Nx cache where its inputs are
        // unchanged and run otherwise. Dropping the edge would let such a change
        // merge unmeasured. Changes that cannot move the floor — repo-tooling and
        // npm — never reach it (tests/AGENTS.md, "Coverage is one floor").
        { "projects": ["oneagentgraph"], "target": "coverage" }
        // llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]
      ]
    }
  }
}
