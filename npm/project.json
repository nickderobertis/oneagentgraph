{
  "name": "oneagentgraph-npm",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "npm/oneagentgraph-cli",
  "tags": ["scope:packaging", "lang:js"],
  "targets": {
    "bootstrap": { "executor": "nx:noop" },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome format --write npm scripts"
    },
    "format-check": { "command": "node node_modules/@biomejs/biome/bin/biome format npm scripts" },
    "lint": { "command": "node node_modules/@biomejs/biome/bin/biome lint npm scripts" },
    "test": {
      "command": "node --test npm/test/*.test.mjs",
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/scripts/npm-build.mjs",
        "{workspaceRoot}/.github/workflows/release.yml",
        "{workspaceRoot}/src/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "sharedGlobals"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test"]
    }
  }
}
