{
  "name": "oneagentgraph-workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:repo", "lang:rust"],
  "targets": {
    "lint-llm-diff": { "command": "llmlint --diff --diff-base \"$LLMLINT_DIFF_BASE_SHA\"" },
    "screenshots": {
      "command": "just _crate-screenshots",
      "inputs": ["screenshotSource"],
      "outputs": ["{workspaceRoot}/shots/current", "{workspaceRoot}/docs/screenshots/*.svg"]
    },
    "msrv": { "command": "just _msrv", "cache": false },
    "deps-check": { "command": "just _deps-check", "cache": false }
  }
}
