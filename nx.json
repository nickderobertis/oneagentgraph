{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/justfile"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "screenshotSource": [
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/screenshots/**/*",
      "{workspaceRoot}/scripts/screenshots.sh",
      "{workspaceRoot}/screencomp.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "sharedGlobals"
    ],
    "crateSource": [
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "sharedGlobals"
    ],
    "crateFormat": ["{workspaceRoot}/src/**/*.rs", "{workspaceRoot}/rustfmt.toml", "sharedGlobals"],
    "contractSource": ["{workspaceRoot}/tests/*.rs", "{workspaceRoot}/tests/support/**/*", "sharedGlobals"],
    "contractReads": [
      "{workspaceRoot}/tests/golden/**/*",
      "{workspaceRoot}/tests/recorded/**/*",
      "{workspaceRoot}/tests/yaml-corpus/**/*",
      "{workspaceRoot}/screenshots/fixture/**/*",
      "{workspaceRoot}/docs/contract.md",
      "{workspaceRoot}/docs/persona-format.md",
      "{workspaceRoot}/docs/oneharness-library.md",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/scripts/smoke-published.sh",
      "{workspaceRoot}/scripts/release-probe.sh",
      "{workspaceRoot}/scripts/release-package.py",
      "{workspaceRoot}/scripts/release-build.sh",
      "{workspaceRoot}/scripts/release-smoke.sh",
      "{workspaceRoot}/scripts/setup-packaging.sh",
      "{workspaceRoot}/scripts/npm-build.mjs",
      "{workspaceRoot}/npm/test/release-targets.test.mjs",
      "{workspaceRoot}/npm/test/support/declaration.mjs",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/.github/workflows/release.yml",
      "{workspaceRoot}/npm/oneagentgraph-cli/package.json"
    ],
    "e2eSource": ["{workspaceRoot}/tests/e2e/**/*.rs", "sharedGlobals"],
    "e2eReads": ["{workspaceRoot}/README.md", "{workspaceRoot}/scripts/smoke-published.sh"],
    "repoToolingSource": [
      "{workspaceRoot}/tests/repo-tooling/**/*.rs",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "sharedGlobals"
    ],
    "repoToolingReads": [
      "{workspaceRoot}/.githooks/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/**/project.json",
      "{workspaceRoot}/.github/workflows/**/*",
      "{workspaceRoot}/.gitignore"
    ]
  },
  "targetDefaults": {
    "bootstrap": { "cache": false },
    "format": { "cache": false },
    "format-check": { "cache": true, "inputs": ["default"] },
    "lint": { "cache": true, "inputs": ["default"] },
    "test": { "cache": true, "inputs": ["default"] },
    "test-quick": { "cache": false },
    "doc": { "cache": true, "inputs": ["default"] },
    "coverage": { "cache": true },
    "check": {
      "cache": false,
      "dependsOn": ["format-check", "lint", "test"]
    },
    "screenshots": { "cache": true, "inputs": ["screenshotSource"] },
    "budgets": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        { "dependentTasksOutputFiles": "**/telemetry/*.json" },
        { "externalDependencies": ["@onebudgetspec/cli"] }
      ]
    },
    "budgets-host": { "cache": false },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        { "runtime": "bash scripts/workspace-digest.sh" },
        { "env": "LLMLINT_DIFF_BASE_SHA" },
        { "runtime": "./scripts/llmlint-fingerprint.sh" }
      ]
    }
  }
}
