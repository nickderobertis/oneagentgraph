# The one source for every version the capture pins and more than one caller
# restates. `scripts/screenshots.sh`, `scripts/demo-gif.py`, the `screenshots-*`
# recipes in the justfile, and the `capture-command` in
# `.github/workflows/visual-docs.yml` all read this file rather than carrying a
# copy, so there is nothing for a bump to leave behind. Plain `KEY=value` lines:
# bash `source`s it and Python parses it, so no quoting, no interpolation, no
# comments after a value.
#
# The renderer. Bumping it reflows every shot: re-bless (`just screenshots-bless`)
# in the same change.
FREEZE_VERSION=0.2.2
# The vendored font, relative to `screenshots/`. Embedded into every SVG as
# base64 — which is what makes a shot render identically on GitHub, on crates.io,
# and offline — and the same file the demo GIF draws with. Bumping it reflows
# every shot too.
FONT_FILE=fonts/JetBrainsMono-Regular.ttf
